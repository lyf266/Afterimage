# Afterimage Local Environment Template
# Copy this file to .env or ~/.config/afterimage/.env to configure private AI providers
# WARNING: NEVER commit your actual .env file with secrets to Git!

# Google Gemini API
GEMINI_API_KEY=

# DeepSeek / OpenAI Compatible
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
